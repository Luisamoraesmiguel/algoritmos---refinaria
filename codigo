def exibir_cabecalho():
    print("="*50)
    print("{:^50}".format("BEM-VINDO AO SEUC-4!"))
    print("{:^50}".format("REFINARIA DELTA-9 - SISTEMA SEUC-4"))
    print("{:^50}".format("SENTINELA DE FLUXO ATIVA"))
    print("="*50)

def ajuste(valor):
    if valor > 150:
        return valor*1.08
    else:
        return valor*0.96

def classificar_a_zona(valor):
    valor_ajustado = ajuste(valor)
    if 120 <= valor_ajustado <= 180:
        return "Verde"
    elif valor_ajustado > 250:
        return "Vermelha"
    else:
        return "Amarela"

def iniciar_monitoramento():
    cont_leituras=0
    cont_zona_verde=0
    soma_pressoes=0
    travamento=0
    cont_zona_vermelha=0
    menor_pressao=-1
    desgaste=0
    exibir_cabecalho()
    total = int(input("\n>>> Digite o total de leituras programadas para o turno: "))
    print("INÍCIANDO MONITORAMENTO DE TURNOS... ")

    for i in range(total):
        pressao=float(input("\n>>> Digite a pressão da leitura : "))
        cont_leituras+=1
        ajustada = ajuste(pressao)
        desgaste = desgaste + (ajustada - pressao)
        soma_pressoes+=ajustada
        zona = classificar_a_zona(ajustada)
        if menor_pressao == -1 or ajustada < menor_pressao:
                menor_pressao = ajustada
        if zona == "Verde":
            cont_zona_verde+=1
            cont_zona_vermelha=0
        elif zona == "Vermelha":
            cont_zona_vermelha+=1
        else:
            cont_zona_vermelha=0

        print(f">>> PRESSÃO AJUSTADA: {ajustada:.2f} UPC || ZONA: {zona}")

        if cont_zona_vermelha == 2:
            print("\n!!! ALERTA: FADIGA DE MATERIAL DETECTADA !!!")
            print("!!! 2 ZONAS VERMELHAS CONSECUTIVAS !!!")
            print("!!! SISTEMA INTERROMPIDO POR SEGURANÇA  !!!")
            status_travamento = 1
            break

    print("\n==================================================")
    print("             RELATÓRIO DE OPERAÇÃO")
    print("==================================================")
        
    if cont_leituras> 0:
        media = soma_pressoes / cont_leituras
        perc_verde = (cont_zona_verde / cont_leituras) * 100
            
        print(f"\n1. Média das pressões: {media:.2f} UPC")
        print(f"2. Menor pressão registrada: {menor_pressao:.2f} UPC")
        print(f"3. Estabilidade (Percentual de Zona Verde): {perc_verde:.2f}%")
        print(f"4. Desgaste Total: {desgaste:.2f} UPC")
            
        if travamento == 1:
            perc_realizado = (cont_leituras / total) * 100
            print(f"1. STATUS: TRAVAMENTO IMEDIATO")
            print(f"2. PERCENTUAL EXECUTADO: {perc_realizado:.2f}%")
            print(f"3. Desgaste Total: {desgaste:.2f} UPC")
        else:
            print("{:^50}".format("STATUS: TURNO FINALIZADO COM SUCESSO"))
        
    print("==================================================")
iniciar_monitoramento()

