#função ajuste, apagar dps
def ajuste(valor):
    if valor > 150:
        return valor*1.08
    if valor <= 150:
        return valor*0.96
    
#função classificar, apagar dps
def classificar_a_zona(valor):
    valor_ajustado = ajuste(valor)
    if 120 <= valor_ajustado <= 180:
        return "Verde"
    elif valor_ajustado > 250:
        return "Vermelha"
    else:
        return "Amarela"


